# ═══════════════════════════════════════════════════════════════════════════════
# J.A.R.V.I.S Autonomous Agent Core — Environment Configuration
# Copy this file to .env and configure your secret credentials.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Inference Engine & Model Configuration ────────────────────────────────────
# Get your free or paid API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Model identifier: gemini-2.5-flash (Fast & lightweight) | gemini-2.5-pro (Deep reasoning)
GEMINI_MODEL=gemini-2.5-flash

# Model inference temperature: 0.0 (deterministic/code) to 1.0 (creative)
TEMPERATURE=0.2

# ── Autonomous Execution & Timeouts ───────────────────────────────────────────
# Maximum execution time for an entire autonomous turn (seconds)
AGENT_TIMEOUT_SECONDS=120

# Maximum execution duration for a single subprocess command (seconds)
COMMAND_TIMEOUT_SECONDS=30

# Maximum output buffer size captured from subprocesses (bytes)
MAX_OUTPUT_BYTES=65536

# ── Safety & Command Sandboxing ───────────────────────────────────────────────
# Safety policy mode: STRICT (blocks destructive commands) | AUDIT_ONLY | PERMISSIVE
SAFETY_LEVEL=STRICT

# Authorized directory root for file manipulation tools (relative or absolute)
SANDBOX_ROOT=./workspace

# Allow network outbound HTTP requests via web tools: true | false
ALLOW_NETWORKING=true

# ── State & Persistence ───────────────────────────────────────────────────────
# Path to SQLite database storing sessions, messages, and command audit logs
DATABASE_PATH=./data/jarvis_memory.db

# Retain maximum audit logs in SQLite database
MAX_AUDIT_LOG_RECORDS=5000

# ── Logging & Telemetry ───────────────────────────────────────────────────────
# Console log verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Enable psutil background resource sampling: true | false
ENABLE_TELEMETRY=true

